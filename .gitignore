# ── 依赖 ──
node_modules/

# ── 构建产物 ──
dist/
build/
release/
out/

# ── 可执行文件（便携版由 CI/本地构建生成）──
*.exe

# ── 由 gen-icon.js 生成的图标（属构建产物，运行 node gen-icon.js 重新生成）──
icon-vault-md-*.png

# ── 环境变量 / 密钥 / 密码 / Token ──
.env
.env.*
*.local

# ── 日志 ──
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── 本地数据库 / 用户隐私数据 ──
*.db
*.sqlite
*.sqlite3
vault_data/
user-data/

# ── 编辑器 / IDE ──
.vscode/
.idea/
.claude/
.DS_Store
Thumbs.db

# ── 测试覆盖率 ──
coverage/
.nyc_output/

# ── WorkBuddy 内部文件（记忆/任务状态，非项目源码）──
.workbuddy/
